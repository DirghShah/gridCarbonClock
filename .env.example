# Data source: "ercot" (default, scrape ERCOT public reports) or "eia" (EIA Open Data fallback)
DATA_SOURCE=ercot

# Required if DATA_SOURCE=eia. Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional: Vercel KV (Upstash Redis) for cross-instance caching.
# If unset, falls back to in-memory cache (fine for low traffic).
KV_REST_API_URL=
KV_REST_API_TOKEN=
