# Free EIA Open Data API key (instant signup at https://www.eia.gov/opendata/register.php)
# Without this, the site shows realistic demo data with a banner.
EIA_API_KEY=

# Set to "mock" to force demo data (useful for offline dev). Default: live EIA.
DATA_SOURCE=

# Optional: Vercel KV (Upstash Redis) for cross-instance caching.
# If unset, falls back to in-memory cache (fine for low traffic).
KV_REST_API_URL=
KV_REST_API_TOKEN=
